# ── d3m-landing: environment template ─────────────────────────────────────
# Copy to `.env` and fill in your values:  cp .env.example .env
# `.env` is git-ignored and NEVER committed.

# ── Server bind ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# ── Public site info ──────────────────────────────────────────────────────
# Cosmetic: printed at startup. The real public URLs below go to the browser.
SITE_DOMAIN=d3mvpn.local
# «Кабинет / Регистрация» button + links on the landing.
DASHBOARD_URL=https://cabinet.d3mvpn.local
# «Начать в Telegram» button.
TELEGRAM_BOT_URL=https://t.me/d3mvpn_bot
# «Тарифы от {MIN_PRICE}{CURRENCY}».
MIN_PRICE=80
CURRENCY=₽

# ── Node status (Remnawave panel) ─────────────────────────────────────────
# Panel base URL, WITHOUT trailing /api  →  https://panel.example.com
# Get the token in the panel: Settings → API Tokens → Create.
# Token stays server-side, never reaches the browser.
# If both are empty, /api/nodes-status returns source:none (landing still works).
REMNAWAVE_API_URL=
REMNAWAVE_API_TOKEN=

# ── Promo easter eggs (optional) ──────────────────────────────────────────
# Shown IN THE BROWSER via /config.js — treat codes as public marketing,
# not secrets. Empty code disables that egg.
# Egg 1: visitor types the word "promo" anywhere on the page.
PROMO_WORD_CODE=
PROMO_WORD_TEXT=
# Egg 2: visitor triple-clicks the header logo.
PROMO_LOGO_CODE=
PROMO_LOGO_TEXT=

# ── Legal documents (footer links) ────────────────────────────────────────
# Separate pages: Offer, Privacy Policy, Service Rules, Data Consent.
# Publish each as its own page (Telegraph / WebApp / site) and paste URLs.
# Empty value = that link is hidden from the footer.
LEGAL_OFFER_URL=
LEGAL_PRIVACY_URL=
LEGAL_RULES_URL=
LEGAL_CONSENT_URL=
